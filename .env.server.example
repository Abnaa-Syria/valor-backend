# ── Server (staging) settings. Copy to .env on the server and fill in every "change-me".
NODE_ENV=production

# Public HTTPS address of the API (used in video / image links and by Caddy)
API_DOMAIN=api.example.com
PUBLIC_BASE_URL=https://api.example.com

# MySQL (container). Long random passwords.
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# Two different random strings, 32+ characters each (e.g. `openssl rand -hex 48`)
JWT_ADMIN_SECRET=change-me
JWT_USER_SECRET=change-me
JWT_ADMIN_EXPIRES_IN=12h
JWT_USER_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# The dashboard on Vercel (comma-separated if more than one)
CORS_ORIGINS=https://your-dashboard.vercel.app

# First super admin, created by `npm run db:seed`
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

PASSWORD_RESET_URL=valor://reset-password
INVITE_BASE_URL=https://valor.gg/i
VIDEO_MAX_MB=200
JOBS_ENABLED=true
JOBS_INTERVAL_SECONDS=30

# Staging only: no real money, and allow `npm run db:seed:demo`
PAYMENTS_TEST_MODE=true
ALLOW_DEMO_SEED=true
