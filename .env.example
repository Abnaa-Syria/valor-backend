NODE_ENV=development
PORT=4000

# MySQL 8 — mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/valor"

# Dashboard admin tokens — use a long random string (32+ chars)
JWT_ADMIN_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_ADMIN_EXPIRES_IN=12h

# Comma-separated list of allowed origins (the dashboard)
CORS_ORIGINS=http://localhost:5173

# First super admin, created by `npm run db:seed`
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL=admin@valor.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Player tokens (mobile app) — a different long random string from the admin one
JWT_USER_SECRET="change-me-to-another-long-random-string-32-chars"
JWT_USER_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
# Deep link the reset email opens in the app
PASSWORD_RESET_URL=valor://reset-password

# Public URL of this API, used to build links to uploaded files
PUBLIC_BASE_URL=http://localhost:4000
UPLOAD_DIR=uploads
VIDEO_MAX_MB=200

# Background jobs (close battles, expire entries, retry matching)
JOBS_ENABLED=true
JOBS_INTERVAL_SECONDS=30

# Accept purchases with provider "TEST" (no real money). Defaults to true outside production.
PAYMENTS_TEST_MODE=true
