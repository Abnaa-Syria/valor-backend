# Use this instead of Caddy when the server already runs Nginx.
# Replace api.example.com, then get a certificate: sudo certbot --nginx -d api.example.com
server {
    server_name api.example.com;
    client_max_body_size 250m;   # video uploads (VIDEO_MAX_MB + margin)

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_request_buffering off;
    }
}
